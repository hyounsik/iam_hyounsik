{
  "name": "hyounsik-info",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync-images && next dev",
    "build": "npm run sync-images && next build",
    "sync-images": "node scripts/sync-images.mjs",
    "check-images": "node scripts/sync-images.mjs --check",
    "lint": "next lint",
    "clean": "rm -rf .next out",
    "preview": "npm run build && firebase emulators:start --only hosting",
    "serve": "serve out",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:ci": "npm run build && GOOGLE_APPLICATION_CREDENTIALS=.cert/firebase-service-account.json firebase deploy --only hosting --non-interactive"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
